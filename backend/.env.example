# ID from the sheet URL: https://docs.google.com/spreadsheets/d/<THIS_PART>/edit
GOOGLE_SHEET_ID=

# Option A: path to the service-account JSON key (relative to backend/)
GOOGLE_KEY_FILE=./service-account.key.json

# Option B: paste the credentials directly (leave GOOGLE_KEY_FILE empty)
# GOOGLE_SERVICE_ACCOUNT_EMAIL=my-bot@my-project.iam.gserviceaccount.com
# GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

PORT=3001

# Password for the app. Required when NODE_ENV=production; leave empty locally to skip login.
APP_PASSWORD=


# --- Media storage (Google Drive via Apps Script), optional. See README: "Media storage". ---
# The media folder's link, and the script's id (Apps Script → ⚙️ Project Settings → Script ID).
# Used by `npm run media-script:deploy`; the server itself doesn't need them.
MEDIA_FOLDER_URL=
MEDIA_SCRIPT_ID=
# Web app URL of backend/apps-script/media-bridge.gs (ends in /exec).
MEDIA_SCRIPT_URL=
# A long random string; the same value goes into SECRET in the script. e.g. `openssl rand -hex 24`
MEDIA_SCRIPT_SECRET=
# Ends every stored file name: <Section>_<Title>_<Owner>.png
MEDIA_OWNER_NAME=
